# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# Matches the credentials in docker-compose.yml
DATABASE_URL=postgresql://workshop:workshop@localhost:5432/auth_workshop

# ── Better Auth (Phase 3) ─────────────────────────────────────────────────────
# Generate: openssl rand -base64 32    (must be ≥ 32 characters)
BETTER_AUTH_SECRET=
# Must match the server origin exactly — no trailing slash
BETTER_AUTH_URL=http://localhost:4000

# ── Google OAuth (Phase 3) ────────────────────────────────────────────────────
# See: docs/WORKSHOP_CONTEXT.md → Google Cloud OAuth setup checklist (added Phase 10)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Role assignment (Phase 3) ─────────────────────────────────────────────────
# Comma-separated list of emails that become "admin" on first login
ADMIN_EMAILS=

# ── Dev-only fallback login (Phase 3) ─────────────────────────────────────────
# Set to "true" ONLY when demoing without Google / without network.
# The route is physically absent when this is not "true". Never set in production.
DEV_LOGIN_ENABLED=false
