{
  "name": "auth-workshop-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file ../.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "auth:generate": "better-auth generate --output ./src/db/auth-schema.ts -y",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "check": "vitest run"
  },
  "dependencies": {
    "better-auth": "1.7.25",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "0.45.4",
    "express": "^4.21.2",
    "express-rate-limit": "^8.0.0",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.22",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.1",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "0.31.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.5"
  }
}
